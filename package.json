{
  "name": "re-sort-local-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @resort/contracts build && concurrently -n api,web -c green,blue \"pnpm --filter @resort/api dev\" \"pnpm --filter @resort/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm --filter @resort/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @resort/contracts build && pnpm -r test",
    "test:integration": "pnpm --filter @resort/api test:integration",
    "db:migrate": "pnpm --filter @resort/api db:migrate",
    "db:seed": "pnpm --filter @resort/api db:seed",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
